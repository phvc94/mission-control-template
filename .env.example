# Mission Control settings for docker compose. Copy to .env and fill in; never commit .env.

# Sign-in. token: a shared access token you type once per browser (session cookie, 7 days).
# Generate one with: openssl rand -hex 32
MC_AUTH=token
MC_ACCESS_TOKEN=
# Other modes: proxy (a reverse proxy sends the user in a header), cloudflare-access, or none
# (no login; needs MC_ALLOW_UNAUTHENTICATED_BIND=1 and works only at http://127.0.0.1). See docs/INSTALL.md.

# OpenClaw Gateway. On this machine: ws://host.docker.internal:18789. Remote: wss://... (or ws:// over Tailscale).
MC_GATEWAY_URL=ws://host.docker.internal:18789
# The Gateway's shared token (gateway.auth.token in the OpenClaw configuration).
MC_GATEWAY_TOKEN=

# Workspace (optional): your Markdown/Git folder on this machine, as an absolute path or ./relative.
# Leave empty to run without tasks, projects and documents.
MC_WORKSPACE_DIR=
# Folder names in the workspace: auto (detects tasks/ or tarefas/), en or pt.
MC_WORKSPACE_LAYOUT=auto

# Time zone: decides "today" for due dates and the times shown. IANA name, e.g. America/New_York.
TZ=UTC
# Port on this machine: the dashboard opens at http://127.0.0.1:4318.
MC_PORT=4318
# Only when a reverse proxy serves the dashboard on another address, e.g. https://dashboard.example.com.
MC_ORIGIN=
